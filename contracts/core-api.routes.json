{
  "$comment": "The Core API route list, for products built on Omazy. The API fails its tests when a route under /api/v1/core is missing here or differs, and each SDK fails its tests when it does not cover a route. A route is added here in the same commit that adds it to the API. sdk names the client method; mcp_tool names the tool on POST /mcp that runs the route, when there is one. idempotency_key marks a route that honours the Idempotency-Key header: a client may send such a request again with the same key. websocket marks a route that is a WebSocket: the client sends the GET as an Upgrade request with the same Authorization header. public marks a route that needs no token: GET /contract serves this file, as the live platform was built with it.",
  "base": "/api/v1/core",
  "auth": "Authorization: Bearer cai_<prefix>.<secret>",
  "routes": [
    { "method": "GET",    "path": "/whoami",                                  "scope": "",                     "sdk": "whoami",                      "mcp_tool": "whoami" },
    { "method": "GET",    "path": "/contract",                                "scope": "",                     "sdk": "contract",                    "public": true },
    { "method": "POST",   "path": "/ai/complete",                             "scope": "ai:complete",          "sdk": "ai.complete",                 "mcp_tool": "ai_complete" },
    { "method": "POST",   "path": "/ai/embeddings",                           "scope": "ai:complete",          "sdk": "ai.embed" },
    { "method": "GET",    "path": "/ai/models",                               "scope": "ai:complete",          "sdk": "ai.models" },
    { "method": "GET",    "path": "/ai/roles",                                "scope": "ai:complete",          "sdk": "ai.roles.list" },
    { "method": "PUT",    "path": "/ai/roles/{name}",                         "scope": "ai:configure",         "sdk": "ai.roles.set" },
    { "method": "DELETE", "path": "/ai/roles/{name}",                         "scope": "ai:configure",         "sdk": "ai.roles.delete" },
    { "method": "POST",   "path": "/knowledge/search",                        "scope": "kb:search",            "sdk": "knowledge.search",            "mcp_tool": "knowledge_search" },
    { "method": "GET",    "path": "/knowledge/documents",                     "scope": "kb:read",              "sdk": "knowledge.documents.list",    "mcp_tool": "knowledge_documents_list" },
    { "method": "POST",   "path": "/knowledge/documents",                     "scope": "kb:write",             "sdk": "knowledge.documents.create",  "mcp_tool": "knowledge_document_create", "idempotency_key": true },
    { "method": "GET",    "path": "/knowledge/documents/{id}",                "scope": "kb:read",              "sdk": "knowledge.documents.get",     "mcp_tool": "knowledge_document_get" },
    { "method": "PATCH",  "path": "/knowledge/documents/{id}",                "scope": "kb:write",             "sdk": "knowledge.documents.update",  "mcp_tool": "knowledge_document_update" },
    { "method": "DELETE", "path": "/knowledge/documents/{id}",                "scope": "kb:write",             "sdk": "knowledge.documents.delete",  "mcp_tool": "knowledge_document_delete" },
    { "method": "POST",   "path": "/knowledge/import",                        "scope": "kb:write",             "sdk": "knowledge.import_file", "idempotency_key": true },
    { "method": "GET",    "path": "/knowledge/sources",                       "scope": "kb:read",              "sdk": "knowledge.sources.list",      "mcp_tool": "knowledge_sources_list" },
    { "method": "POST",   "path": "/knowledge/sources",                       "scope": "kb:write",             "sdk": "knowledge.sources.create",    "mcp_tool": "knowledge_source_create", "idempotency_key": true },
    { "method": "POST",   "path": "/knowledge/sources/{id}/crawl",            "scope": "kb:write",             "sdk": "knowledge.sources.crawl",     "mcp_tool": "knowledge_source_crawl", "idempotency_key": true },
    { "method": "GET",    "path": "/knowledge/export",                        "scope": "kb:read",              "sdk": "knowledge.export" },
    { "method": "POST",   "path": "/agent/turn",                              "scope": "agent:run",            "sdk": "agent.turn",                  "mcp_tool": "agent_turn", "idempotency_key": true },
    { "method": "GET",    "path": "/agent/settings",                          "scope": "agent:configure",      "sdk": "agent.settings.get" },
    { "method": "PATCH",  "path": "/agent/settings",                          "scope": "agent:configure",      "sdk": "agent.settings.update" },
    { "method": "GET",    "path": "/usage",                                   "scope": "usage:read",           "sdk": "usage.get" },
    { "method": "GET",    "path": "/budgets",                                 "scope": "usage:read",           "sdk": "budgets.list" },
    { "method": "PUT",    "path": "/budgets",                                 "scope": "ai:configure",         "sdk": "budgets.set" },
    { "method": "DELETE", "path": "/budgets/{id}",                            "scope": "ai:configure",         "sdk": "budgets.delete" },
    { "method": "GET",    "path": "/agent/mcp-servers",                       "scope": "agent:tools",          "sdk": "agent.mcp_servers.list" },
    { "method": "POST",   "path": "/agent/mcp-servers",                       "scope": "agent:tools",          "sdk": "agent.mcp_servers.create",    "idempotency_key": true },
    { "method": "GET",    "path": "/agent/mcp-servers/{id}",                  "scope": "agent:tools",          "sdk": "agent.mcp_servers.get" },
    { "method": "PATCH",  "path": "/agent/mcp-servers/{id}",                  "scope": "agent:tools",          "sdk": "agent.mcp_servers.update" },
    { "method": "DELETE", "path": "/agent/mcp-servers/{id}",                  "scope": "agent:tools",          "sdk": "agent.mcp_servers.delete" },
    { "method": "POST",   "path": "/voice/speak",                             "scope": "voice:speech",         "sdk": "voice.speak" },
    { "method": "POST",   "path": "/voice/transcribe",                        "scope": "voice:speech",         "sdk": "voice.transcribe" },
    { "method": "GET",    "path": "/voice/transcribe/stream",                 "scope": "voice:speech",         "sdk": "voice.transcribe_stream", "websocket": true },
    { "method": "POST",   "path": "/voice/calls",                             "scope": "voice:calls",          "sdk": "voice.calls.place",           "mcp_tool": "call_place", "idempotency_key": true },
    { "method": "GET",    "path": "/voice/calls/{ref}",                       "scope": "voice:calls",          "sdk": "voice.calls.get",             "mcp_tool": "call_status" },
    { "method": "POST",   "path": "/voice/jobs",                              "scope": "voice:tasks",          "sdk": "voice.jobs.create",           "mcp_tool": "voice_job_create", "idempotency_key": true },
    { "method": "GET",    "path": "/voice/jobs/{id}",                         "scope": "voice:tasks",          "sdk": "voice.jobs.get",              "mcp_tool": "voice_job_get" },
    { "method": "GET",    "path": "/customers/{id}",                          "scope": "core:read",            "sdk": "customers.get",               "mcp_tool": "customer_get" },
    { "method": "PATCH",  "path": "/customers/{id}",                          "scope": "memory:write",         "sdk": "customers.update",            "mcp_tool": "customer_update" },
    { "method": "POST",   "path": "/conversations/{id}/messages",             "scope": "core:write",           "sdk": "conversations.post_message",  "mcp_tool": "conversation_post_message", "idempotency_key": true },
    { "method": "POST",   "path": "/channels/linkedin/publish",               "scope": "channels:publish",     "sdk": "channels.linkedin_publish", "idempotency_key": true },
    { "method": "PUT",    "path": "/sessions/{sid}/mcp-credentials/{server}", "scope": "sessions:credentials", "sdk": "sessions.bind_credential" },
    { "method": "DELETE", "path": "/sessions/{sid}/mcp-credentials/{server}", "scope": "sessions:credentials", "sdk": "sessions.unbind_credential" },
    { "method": "POST",   "path": "/mcp",                                     "scope": "",                     "sdk": "mcp" }
  ]
}
