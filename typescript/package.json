{
  "name": "@omazyai/sdk",
  "version": "0.5.0",
  "description": "Client for the Omazy Core API and its MCP server: models, knowledge, your agent, speech and calls from your own backend.",
  "keywords": [
    "omazy",
    "ai",
    "llm",
    "agents",
    "mcp",
    "knowledge-base",
    "voice",
    "sdk"
  ],
  "author": "Mosthofa Imran (https://github.com/johnefemer)",
  "license": "MIT",
  "homepage": "https://docs.omazy.ai/reference/core-api/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omazyai/omazy-sdk.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/omazyai/omazy-sdk/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities/index.d.ts",
      "default": "./dist/capabilities/index.js"
    },
    "./guard": {
      "types": "./dist/guard/index.d.ts",
      "default": "./dist/guard/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    },
    "./oauth": {
      "types": "./dist/oauth/index.d.ts",
      "default": "./dist/oauth/index.js"
    },
    "./oauth/keys": {
      "types": "./dist/oauth/keys.d.ts",
      "default": "./dist/oauth/keys.js"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "default": "./dist/ai/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/ai/ai-sdk.d.ts",
      "default": "./dist/ai/ai-sdk.js"
    },
    "./actors": {
      "types": "./dist/actors/index.d.ts",
      "default": "./dist/actors/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./flows": {
      "types": "./dist/flows/index.d.ts",
      "default": "./dist/flows/index.js"
    },
    "./copilot": {
      "types": "./dist/copilot/index.d.ts",
      "default": "./dist/copilot/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./ui/server": {
      "types": "./dist/ui/server.d.ts",
      "default": "./dist/ui/server.js"
    },
    "./ui/react": {
      "types": "./dist/ui/react/index.d.ts",
      "default": "./dist/ui/react/index.js"
    },
    "./ui/styles.css": "./dist/ui/styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"import('./dist/ui/styles.js').then((m) => require('node:fs').writeFileSync('dist/ui/styles.css', m.UI_CSS))\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "check": "npm run typecheck && npm run test",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@ai-sdk/provider": "4.0.39",
    "@cloudflare/workers-oauth-provider": "1.3.0",
    "@modelcontextprotocol/server": "2.4.0",
    "autoevals": "0.5.0",
    "react": ">=18.2.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/provider": {
      "optional": true
    },
    "@cloudflare/workers-oauth-provider": {
      "optional": true
    },
    "@modelcontextprotocol/server": {
      "optional": true
    },
    "autoevals": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.39",
    "@cloudflare/workers-oauth-provider": "1.3.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@types/bun": "^1.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ai": "7.0.180",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "miniflare": "4.20260730.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^5.6.0",
    "zod": "4.6.7"
  }
}
