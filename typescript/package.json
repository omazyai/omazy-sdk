{
  "name": "@omazyai/sdk",
  "version": "0.4.0",
  "description": "Client for the Omazy Core API and its MCP server: models, knowledge, your agent, speech and calls from your own backend.",
  "keywords": [
    "omazy",
    "ai",
    "llm",
    "agents",
    "mcp",
    "knowledge-base",
    "voice",
    "sdk"
  ],
  "author": "Mosthofa Imran (https://github.com/johnefemer)",
  "license": "MIT",
  "homepage": "https://docs.omazy.ai/reference/core-api/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omazyai/omazy-sdk.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/omazyai/omazy-sdk/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "check": "npm run typecheck && npm run test",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.6.0"
  }
}
